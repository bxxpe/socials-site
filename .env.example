# Copy this file to .env and fill in your values.
# Without the Supabase pair the site runs in DEMO MODE (saves to your browser only).

# Supabase Dashboard:
#   URL:  Project Settings -> Data API -> Project URL  (bare origin, no /rest/v1)
#   Key:  Project Settings -> API Keys -> "Publishable key" (sb_publishable_...)
#         (older projects call this the "anon public" key — either works)
# NEVER put the secret key (sb_secret_...) here — this site doesn't use it.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: pin which profile the homepage shows. Only matters if more than
# one account ever exists. Leave empty to show the first profile created.
VITE_OWNER_USERNAME=

# Optional: Discord "connect" button (live presence).
# Create an app at https://discord.com/developers/applications, add
# <your-site>/discord/callback under OAuth2 -> Redirects, then paste the
# Client ID here. No bot and no client secret needed.
VITE_DISCORD_CLIENT_ID=

# Optional: Last.fm top artists. Free, read-only key — safe to ship in the
# bundle. Get one at https://www.last.fm/api/account/create
VITE_LASTFM_KEY=
