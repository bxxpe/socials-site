# Copy this file to .env and fill in your Supabase project values.
# Without these the site runs in DEMO MODE (everything saves to your browser only).

# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: pin which profile the homepage shows (useful if you ever have
# more than one account). Leave empty to show the first profile created.
VITE_OWNER_USERNAME=

# Discord "connect" button (live presence like guns.lol).
# Create an app at https://discord.com/developers/applications, add
# <your-site>/discord/callback under OAuth2 -> Redirects, then paste the
# Client ID here. No bot and no client secret needed.
VITE_DISCORD_CLIENT_ID=
